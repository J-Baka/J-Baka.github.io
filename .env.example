# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored, so your keys never get committed.

# LocationIQ API token — powers the property-map demo's tiles + address geocoding.
# Get one free at https://locationiq.com (Dashboard → Access Tokens).
# In production this is supplied by the GitHub Actions secret LOCATIONIQ_KEY instead.
VITE_LOCATIONIQ_KEY=
