# Normalize text files to LF in the repo; let Git auto-detect what's text.
* text=auto eol=lf

# Binary assets — never apply end-of-line conversion (prevents corruption).
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.JPG  binary
*.JPEG binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
